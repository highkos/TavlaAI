    <None Include="..\ml\artifacts\golden_outputs.json" Link="Models\golden_outputs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ml\artifacts\model_v2.onnx" Link="Models\model_v2.onnx" CopyToOutputDirectory="PreserveNewest" />
