    <Compile Include="..\Backgammon.Tests\VectorTestSupport.cs" Link="Shared\VectorTestSupport.cs" />
    <Compile Include="..\Backgammon.Tests\Search\SearchTestSupport.cs" Link="Shared\SearchTestSupport.cs" />
    <Compile Include="..\Backgammon.Tests\Search\ReferenceSearch.cs" Link="Shared\ReferenceSearch.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ml\artifacts\model_v1.onnx" Link="Models\model_v1.onnx" CopyToOutputDirectory="PreserveNewest" />
